# Public canonical origin used for metadata and sitemap generation.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Required for persistent auth and PostgreSQL-backed private data.
DATABASE_URL=postgres://user:password@host:5432/admitos
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=https://your-domain.example

# Optional server-only providers.
GEMINI_API_KEY=replace-with-server-only-key
GEMINI_MODEL=gemini-2.5-flash
RESEND_API_KEY=replace-with-server-only-key
